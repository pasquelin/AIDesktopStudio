{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.cache/tsc/web.tsbuildinfo",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "@testing-library/jest-dom"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["../src/renderer/src/*"],
      "@game/*": ["../src/game/*"],
      "@shared/*": ["../src/shared/*"]
    }
  },
  "include": [
    "../src/renderer/**/*.ts",
    "../src/renderer/**/*.tsx",
    "../src/shared/**/*.ts",
    "../src/game/**/*.ts",
    "../src/game/**/*.tsx"
  ]
}
