{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.cache/tsc/banc.tsbuildinfo",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node",
      "vite/client"
    ],
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "../src/renderer/src/*"
      ],
      "@game/*": [
        "../src/game/*"
      ],
      "@main/*": [
        "../src/main/*"
      ],
      "@shared/*": [
        "../src/shared/*"
      ]
    }
  },
  "include": [
    "../scripts/banc/**/*.ts",
    "../src/**/*.d.ts",
    "./vitest.banc.config.ts"
  ]
}
