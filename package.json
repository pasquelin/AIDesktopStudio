{
  "name": "ai-desktop-studio",
  "productName": "AI Desktop Studio",
  "version": "2.0.0",
  "description": "Image, video, 3D, audio, texture and skybox creation studio",
  "author": "Alban Pasquelin",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "scripts": {
    "start": "node scripts/fetch-engine.mjs --sources-only && node scripts/dev-app-identity.mjs && electron-vite dev --watch",
    "start:debug": "node scripts/fetch-engine.mjs --sources-only && node scripts/dev-app-identity.mjs && electron-vite dev --watch --remoteDebuggingPort 9222",
    "cdp": "node scripts/cdp.mjs",
    "world:validate": "node scripts/run-world-safe-validation.mjs",
    "picking:validate": "electron out/main/pickingValidation.js",
    "build": "pnpm typecheck && electron-vite build && pnpm game:runtime && node scripts/check-artefact.mjs",
    "game:runtime": "vite build --config config/vite.game.config.ts",
    "dist": "pnpm build && bash scripts/dist.sh",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p config/tsconfig.node.json && tsc --noEmit -p config/tsconfig.web.json && tsc --noEmit -p config/tsconfig.banc.json",
    "test": "node scripts/vitest.mjs whole run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "banc": "vitest run --config config/vitest.banc.config.ts",
    "banc:mission": "vitest run --config config/vitest.mission-banc.config.ts",
    "unused:main": "knip",
    "duplication": "jscpd",
    "dry": "dry-ts --profile src src",
    "duplication:report": "node scripts/duplication-report.mjs",
    "lint": "oxlint -c oxlint.json src scripts config --deny-warnings",
    "lint:fix": "pnpm lint --fix",
    "format": "prettier --write --cache \"{src,scripts,config}/**/*.{ts,tsx,css,mjs}\"",
    "format:check": "prettier --check --cache \"{src,scripts,config}/**/*.{ts,tsx,css,mjs}\"",
    "sizes:check": "node scripts/check-sizes.mjs",
    "check": "node scripts/check.mjs",
    "engine:check": "node scripts/engine-check.mjs",
    "validate": "pnpm site:check && pnpm llms:check && pnpm licences:check && pnpm sizes:check && node scripts/check-as-const.mjs && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm unused:main && pnpm engine:check && pnpm build",
    "ffmpeg:fetch": "node scripts/fetch-ffmpeg.mjs",
    "stt:fetch": "node scripts/fetch-stt.mjs",
    "engine:fetch": "node scripts/fetch-engine.mjs",
    "engine:prepare:autorig": "node scripts/prepare-engine-runtime.mjs",
    "textures:make": "node scripts/make-checker-textures.mjs",
    "jolt:build": "node scripts/build-jolt.mjs",
    "licences:collect": "node scripts/collect-licences.mjs",
    "engine:licences": "node scripts/collect-python-licences.mjs",
    "manual:collect": "node scripts/collect-manual.ts",
    "ui:schema": "node --import ./scripts/tsResolve.mjs scripts/emit-ui-schema.ts",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "decoders:copy": "node scripts/copy-decoders.mjs",
    "postinstall": "node scripts/dev-app-identity.mjs && node scripts/copy-decoders.mjs",
    "models:pin": "node scripts/pin-models.mjs",
    "models:thumbnails": "node scripts/make-model-thumbnails.mjs",
    "llms": "node scripts/make-llms.mjs",
    "site:check": "node --test site/assets/js/*.test.mjs && node scripts/check-site.mjs",
    "llms:check": "node scripts/make-llms.mjs --check",
    "licences:check": "node scripts/check-licences.mjs",
    "build:site": "node site/build.mjs _site",
    "preview:site": "node scripts/serve.mjs _site --base=/"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.32.0",
    "@mdi/js": "^7.4.47",
    "@mdi/react": "^1.6.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@pasquelin/panels": "0.4.1",
    "@scenario-labs/sdk": "^3.1.0",
    "ag-psd": "^31.0.2",
    "better-sqlite3": "^13.0.3",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "jolt-physics": "file:vendor/jolt-physics",
    "mediabunny": "^1.56.0",
    "node-llama-cpp": "^3.20.0",
    "opentype.js": "^2.0.0",
    "pixi.js": "8.20.1",
    "quickjs-emscripten-core": "^0.32.0",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "sherpa-onnx-node": "1.13.7",
    "simple-git": "^3.36.0",
    "three": "0.185.1",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.14",
    "utif": "^3.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.11",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-is": "^19.2.0",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "daisyui": "^5.7.28",
    "dockview-react": "^8.2.0",
    "dry-ts": "0.14.2",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "i18next": "^26.4.2",
    "immer": "^11.1.18",
    "jscpd": "^5.2.0",
    "jsdom": "^30.0.1",
    "knip": "^6.35.0",
    "monaco-editor": "0.56.0",
    "oxlint": "1.82.0",
    "oxlint-tsgolint": "7.0.2001",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^17.0.13",
    "react-markdown": "^10.1.0",
    "react-tooltip": "^6.0.8",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wavesurfer.js": "^7.12.11",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  }
}
